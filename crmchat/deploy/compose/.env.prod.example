# 生产环境模板：生产密钥不入库。
# 上线前复制为服务器 ~/crm-chat/compose/.env.prod 并补齐全部值
# （部署脚本同步仓库文件时不会覆盖服务器上已存在的 .env.prod）。
# MySQL 使用宿主机实例，需预先建库建号。
APP_KEY=
APP_PORT=20108
APP_DEBUG=false
APP_INSTALLED=false
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=crmchat_prod
DB_USER=crmchat_prod
DB_PASSWORD=
DB_PREFIX=eb_
REDIS_PASSWORD=

# AI智能客服：生产密钥由运维在部署机 .env.prod 中填写，切勿提交进仓库
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=

# 对外地址（部署拓扑）。SERVICE_URL 是接入方浏览器要直达的客服服务地址，
# 写内网地址会让客户站点上的接入代码失效；留空则退回后台的 site_url。
# CONSOLE_URL 留空跟随 SERVICE_URL；WEBSITE_URL 留空则登录页不展示官网入口。
SERVICE_URL=https://chat.example.com
CONSOLE_URL=https://chat.example.com
WEBSITE_URL=https://www.example.com
