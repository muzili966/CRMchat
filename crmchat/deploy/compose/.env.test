# test 环境（内网）。APP_KEY 为 JWT 签名密钥，一经使用不可变更，否则全部登录态失效
# MySQL 使用宿主机实例：需预先执行建库建号SQL（见部署说明），host.docker.internal 即宿主机
APP_KEY=56b5e6d294fcb427db5122ec71d77ec2
APP_PORT=20128
APP_DEBUG=false
# 首次部署走安装向导；装完必须改为true，否则下次部署会重新弹出向导
APP_INSTALLED=false
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=crmchat_test
DB_USER=crmchat_test
DB_PASSWORD=3f79a867cf2d0d096fad824c258b6383
DB_PREFIX=eb_
REDIS_PASSWORD=

# AI智能客服：密钥不入库不进后台，按环境注入；留空=AI能力不可用
# 支持任意OpenAI兼容服务（DeepSeek/通义/智谱/Kimi），改BASE_URL即可
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
