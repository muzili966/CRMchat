# dev 环境（内网）。APP_KEY 为 JWT 签名密钥，一经使用不可变更，否则全部登录态失效
# MySQL 使用宿主机实例：需预先执行建库建号SQL（见部署说明），host.docker.internal 即宿主机
APP_KEY=3318dd9288d2946da3ea86ec4b0e9757
APP_PORT=20118
APP_DEBUG=true
# 已完成安装向导。install.lock在容器内不随重建保留，此处置true由entrypoint重新生成，否则每次部署都会重新弹出安装向导
APP_INSTALLED=true
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=crmchat_dev
DB_USER=crmchat_dev
DB_PASSWORD=1407d372f736ec0949495623e810d78d
DB_PREFIX=eb_
REDIS_PASSWORD=

# AI智能客服：密钥不入库不进后台，按环境注入；留空=AI能力不可用
# 支持任意OpenAI兼容服务（DeepSeek/通义/智谱/Kimi），改BASE_URL即可
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=

# 对外地址（部署拓扑）。SERVICE_URL 是接入方浏览器要直达的客服服务地址，
# 写内网地址会让客户站点上的接入代码失效；留空则退回后台的 site_url。
# CONSOLE_URL 留空跟随 SERVICE_URL；WEBSITE_URL 留空则登录页不展示官网入口。
SERVICE_URL=http://192.168.8.39:20118
CONSOLE_URL=
WEBSITE_URL=http://192.168.8.39:20118
